@model VetCare.Models.Animal

@{
    ViewData["Title"] = "Detalhes do animal";
}

<h1>@Model.Nome</h1>
<dl class="row">
    <dt class="col-sm-3">Espécie</dt>
    <dd class="col-sm-9">@Model.Especie</dd>
    <dt class="col-sm-3">Tutor</dt>
    <dd class="col-sm-9">@Model.Tutor</dd>
    <dt class="col-sm-3">Telefone</dt>
    <dd class="col-sm-9">@Model.Telefone</dd>
    <dt class="col-sm-3">Data de nascimento</dt>
    <dd class="col-sm-9">@Model.DataNascimento.ToString("dd/MM/yyyy")</dd>
</dl>

<a class="btn btn-secondary" asp-action="Index">Voltar</a>
<a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>
