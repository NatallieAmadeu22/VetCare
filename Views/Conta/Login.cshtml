@{
    ViewData["Title"] = "Entrar";
}

<div class="auth-page">
    <div class="auth-card">
        <span class="eyebrow">BEM-VINDO À VETCARE</span>
        <h1 class="mt-2">Entrar</h1>
        <p class="text-muted">Acesse a agenda e os dados dos seus animais.</p>

        @if (TempData["Mensagem"] is string mensagem)
        {
            <div class="alert alert-success">@mensagem</div>
        }

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <form asp-action="Login" method="post">
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
            <div class="mb-3">
                <label class="form-label" for="email">E-mail</label>
                <input class="form-control" id="email" name="email" type="email" required />
            </div>
            <div class="mb-3">
                <label class="form-label" for="senha">Senha</label>
                <input class="form-control" id="senha" name="senha" type="password" required />
            </div>
            <button class="btn btn-primary w-100" type="submit">Entrar</button>
        </form>
        <p class="text-center mt-4 mb-0">Ainda não tem cadastro? <a asp-action="Cadastro">Criar acesso</a></p>
    </div>
</div>
