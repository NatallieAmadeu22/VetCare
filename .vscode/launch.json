{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Executar VetCare",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/bin/Debug/net10.0/VetCare",
      "cwd": "${workspaceFolder}",
      "args": [],
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5080"
      },
      "stopAtEntry": false,
      "preLaunchTask": "build VetCare",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    }
  ]
}
