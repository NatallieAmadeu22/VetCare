{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build VetCare",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/VetCare.csproj"
      ],
      "problemMatcher": "$msCompile",
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "run VetCare",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/VetCare.csproj",
        "--launch-profile",
        "http"
      ],
      "problemMatcher": "$msCompile",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true
    }
  ]
}
