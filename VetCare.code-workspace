{
  "folders": [
    {
      "path": "."
    }
  ],
  "settings": {
    "dotnet.defaultSolution": "VetCare.csproj"
  },
  "launch": {
    "configurations": [
      {
        "name": "Executar VetCare",
        "type": "coreclr",
        "request": "launch",
        "program": "${workspaceFolder}/bin/Debug/net10.0/VetCare",
        "cwd": "${workspaceFolder}",
        "stopAtEntry": false,
        "env": {
          "ASPNETCORE_ENVIRONMENT": "Development",
          "ASPNETCORE_URLS": "http://localhost:5080"
        },
        "preLaunchTask": "build VetCare",
        "serverReadyAction": {
          "action": "openExternally",
          "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
        }
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "build VetCare",
        "type": "process",
        "command": "dotnet",
        "args": [
          "build",
          "${workspaceFolder}/VetCare.csproj"
        ],
        "problemMatcher": "$msCompile",
        "options": {
          "cwd": "${workspaceFolder}"
        }
      }
    ]
  }
}
