<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>VetCare</RootNamespace>
    <AssemblyName>VetCare</AssemblyName>
    <EnableDefaultItems>false</EnableDefaultItems>
    <WebRootPath>../wwwroot</WebRootPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Program.cs" Link="Program.cs" />
    <Compile Include="../Controllers/*.cs" Link="Controllers/%(Filename)%(Extension)" />
    <Compile Include="../Models/*.cs" Link="Models/%(Filename)%(Extension)" />
    <Content Include="../Views/**/*.cshtml" Link="Views/%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="../wwwroot/**/*" Link="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="../appsettings*.json" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
